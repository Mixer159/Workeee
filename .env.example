# Development deployment selected by `pnpm exec convex dev`.
CONVEX_DEPLOYMENT=dev:<deployment-name>

# Public Convex endpoints for the selected deployment.
NEXT_PUBLIC_CONVEX_URL=https://<deployment-name>.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://<deployment-name>.convex.site

# Exact public origin of the Next.js application. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
